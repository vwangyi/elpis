{
  "compilerOptions": {
    "jsx": "preserve", // 或 "react-jsx" (Vue 3.4+)
    "noEmit": true,
    "emitDeclarationOnly": false,
    "rewriteRelativeImportExtensions": false,
    "allowImportingTsExtensions": true,
    "jsxImportSource": "vue", // 如果使用 Vue 3，添加这行
    // 使用什么模块化标准  commonjs 和 es6
    "module": "esnext", 
    // 把ts编译为js时 使用什么es版本 默认是es3
    "target": "esnext", 
    "types": [],
    // 采用什么编译环境   如果需要node 额外安装@types/node 的node环境
    "lib": ["esnext"], 
    "sourceMap": true,
    "declaration": true,
    // 开启严格的空值检查 null和undefined 就不能赋值给任意类型 只能赋值给自己。
    "strictNullChecks": true, 
    "declarationMap": true,
    // 编译结果移除注释
    "removeComments": true,
     // 可以用 import fs from 'fs'
    "esModuleInterop": true,
    // ts发生语法错误时不生成编译结果
    "noEmitOnError": true, 
    // 封装类的属性方法时 属性必须初始化 不初始化值为undefined 是不行的 （属性的初始化检查）
    "strictPropertyInitialization": true, 
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "strict": true,
    "verbatimModuleSyntax": true,
     // 模块解析模式 node和classic classic是旧的  一般用node
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    // 开启对隐式any类型的检查 当ts自动推导为any的隐式any是否类型正确 ，
    // 比如  用中括号访问不存在的成员也会报错，开启这个配置也就意味着 ts会更加严格 ，
    // 如果你的ts很强就开启 不强就不开启
    "noImplicitAny": true 
  },
  "exclude": ["node_modules", "dist"],
  "include": [
    "apps/new-world" // 目前只有这一个项目是ts
  ]
}
